{
  "expo": {
    "name": "Loyainiti",
    "slug": "loyainiti",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/Logo_final.png",
    "scheme": "loyainiti",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FBF8F3"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.loyainiti.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/Logo_final.png",
        "backgroundColor": "#000000"
      },
      "package": "com.loyainiti.app"
    },
    "web": {
      "bundler": "metro",
      "favicon": "./src/design-system/assets/Logo_final.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Loyainiti to use the camera to scan customer QR codes."
        }
      ],
      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {}
  }
}
