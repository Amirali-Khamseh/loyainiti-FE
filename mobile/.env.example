EXPO_PUBLIC_API_URL=http://localhost:3000
# Enable R2's "Public Development URL" in the Cloudflare dashboard, paste it here.
# Without this, business cover/logo/gallery photos won't render.
EXPO_PUBLIC_R2_PUBLIC_BASE_URL=https://pub-XXXXXXXXXXXX.r2.dev
# Android Google Maps key for the shop map (react-native-maps on Android).
# Read by app.config.js at build time — keep the real value in .env (gitignored),
# not in app.json. Restrict the key in Google Cloud Console to package
# com.loyainiti.app + your SHA-1, "Maps SDK for Android" only. iOS needs no key.
ANDROID_GOOGLE_MAPS_API_KEY=
